#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
# pre-commit hook — runs backend + frontend tests before every commit.
# Blocks the commit if any test suite fails.
#
# Install: this file is symlinked automatically by setup_hooks.sh
# Manual:  cp .git-hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
# ─────────────────────────────────────────────────────────────────────────────
set -e

ROOT="$(git rev-parse --show-toplevel)"
YELLOW="\033[33m"
GREEN="\033[32m"
RED="\033[31m"
RESET="\033[0m"

echo ""
echo "╔══════════════════════════════════════════════╗"
echo "║       Saafi AI — Pre-commit Test Suite       ║"
echo "╚══════════════════════════════════════════════╝"
echo ""

FAILED=0

# ── Backend (pytest) ──────────────────────────────────────────────────────────
echo -e "${YELLOW}▶ Running backend tests (pytest)...${RESET}"
cd "$ROOT/backend"

if [ -d "venv" ]; then
  source venv/bin/activate
elif command -v python3 &>/dev/null; then
  echo "  Warning: no venv found, using system Python"
fi

if python3 -m pytest --tb=short -q 2>&1; then
  echo -e "${GREEN}  ✓ Backend tests passed${RESET}"
else
  echo -e "${RED}  ✗ Backend tests FAILED — commit blocked${RESET}"
  FAILED=1
fi

# ── Frontend (Jest) ───────────────────────────────────────────────────────────
echo ""
echo -e "${YELLOW}▶ Running frontend tests (Jest)...${RESET}"
cd "$ROOT/frontend"

if npm test -- --watchAll=false --passWithNoTests 2>&1; then
  echo -e "${GREEN}  ✓ Frontend tests passed${RESET}"
else
  echo -e "${RED}  ✗ Frontend tests FAILED — commit blocked${RESET}"
  FAILED=1
fi

# ── Result ────────────────────────────────────────────────────────────────────
echo ""
if [ $FAILED -ne 0 ]; then
  echo -e "${RED}╔══════════════════════════════════════════════╗"
  echo -e "║  ✗ Tests failed — commit ABORTED              ║"
  echo -e "╚══════════════════════════════════════════════╝${RESET}"
  echo ""
  exit 1
fi

echo -e "${GREEN}╔══════════════════════════════════════════════╗"
echo -e "║  ✓ All tests passed — proceeding with commit  ║"
echo -e "╚══════════════════════════════════════════════╝${RESET}"
echo ""
exit 0
